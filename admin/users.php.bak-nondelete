<?php
declare(strict_types=1);

require_once __DIR__ . '/../includes/functions.php';
requireLogin();
requireAdmin();

$pdo = getPDO();
$current = currentUser();
$editUser = null;

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    if (!verifyCsrfToken($_POST['csrf_token'] ?? null)) {
        setFlash(t('invalid_csrf'), 'danger');
        redirect('admin/users.php');
    }

    $action = (string) ($_POST['action'] ?? '');
    if ($action === 'update_name') {
        $userId = (int) ($_POST['user_id'] ?? 0);
        $name = trim((string) ($_POST['name'] ?? ''));

        if ($userId <= 0 || $name === '') {
            setFlash(tr('Valid user and name are required.', 'Kërkohet përdorues dhe emër i vlefshëm.'), 'warning');
            redirect('admin/users.php');
        }

        $updateStmt = $pdo->prepare('UPDATE users SET name = :name WHERE id = :id');
        $updateStmt->execute([
            'name' => $name,
            'id' => $userId,
        ]);

        setFlash(tr('User name updated.', 'Emri i përdoruesit u përditësua.'), 'success');
        redirect('admin/users.php');
    }

    if ($action === 'delete') {
        $userId = (int) ($_POST['user_id'] ?? 0);
        if ($userId > 0) {
            if ($userId === (int) ($current['id'] ?? 0)) {
                setFlash(tr('You cannot delete your own active account.', 'Nuk mund të fshish llogarinë tënde aktive.'), 'warning');
                redirect('admin/users.php');
            }

            $roleStmt = $pdo->prepare('SELECT role FROM users WHERE id = :id LIMIT 1');
            $roleStmt->execute(['id' => $userId]);
            $target = $roleStmt->fetch();

            if ($target && ($target['role'] ?? '') === 'admin') {
                $adminCount = (int) $pdo->query("SELECT COUNT(*) FROM users WHERE role = 'admin'")->fetchColumn();
                if ($adminCount <= 1) {
                    setFlash(tr('Cannot delete the last admin account.', 'Nuk mund të fshihet admini i fundit.'), 'warning');
                    redirect('admin/users.php');
                }
            }

            $deleteStmt = $pdo->prepare('DELETE FROM users WHERE id = :id');
            $deleteStmt->execute(['id' => $userId]);
            setFlash(tr('User account deleted.', 'Llogaria e përdoruesit u fshi.'), 'info');
        }
        redirect('admin/users.php');
    }
}

if (isset($_GET['edit'])) {
    $editId = (int) $_GET['edit'];
    if ($editId > 0) {
        $editStmt = $pdo->prepare('SELECT id, name, email, role FROM users WHERE id = :id LIMIT 1');
        $editStmt->execute(['id' => $editId]);
        $editUser = $editStmt->fetch() ?: null;
    }
}

$stmt = $pdo->query(
    "SELECT id, name, email, role, created_at
     FROM users
     ORDER BY created_at DESC"
);
$users = $stmt->fetchAll();

$pageTitle = t('admin_users');
require_once __DIR__ . '/../includes/header.php';
?>

